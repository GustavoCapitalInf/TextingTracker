# Local development only. Copy to .env; never commit the populated file.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
COMPANY_TIME_ZONE=America/New_York

# Empty means SQLite in development. Production requires PostgreSQL.
DATABASE_URL=

# Optional absolute directory outside the checkout for local database/runtime data.
# PHONETRACKER_DATA_DIR=/absolute/path/to/phonetracker-data

# Production defaults to true. Leave these true for an HTTPS installation.
# DJANGO_SECURE_SSL_REDIRECT=true
# Session and CSRF cookies are always secure in production.

# See docs/mac-mini-deployment.md before setting DJANGO_ENV=production.
